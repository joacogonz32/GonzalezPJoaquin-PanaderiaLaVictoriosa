# Copiar este archivo como Backend/.env y completar los valores.
# El archivo .env no se sube al repositorio.

PORT=3000

# --- Firebase (Cloud Firestore) ---
# Ruta (relativa a la carpeta Backend) al archivo JSON de la cuenta de servicio
# que se descarga desde la consola de Firebase. Ese archivo tampoco se sube al repositorio.
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# Opcional: para usar el emulador local de Firestore en lugar del proyecto real,
# descomentar estas líneas (no hace falta el archivo de credenciales).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=demo-la-victoriosa

# --- Cuenta de administrador que crea "npm run seed" ---
SEED_ADMIN_NOMBRE=Administracion La Victoriosa
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_TELEFONO=+54 9 11 4521-2319
