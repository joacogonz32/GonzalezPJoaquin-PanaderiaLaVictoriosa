      "name": "0. Autenticación",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@lavictoriosa.com\",\n  \"contrasena\": \"admin1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('devuelve token y rol ADMINISTRADOR', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.usuario.rol).to.eql('ADMINISTRADOR');",
                  "    pm.expect(json.data.usuario).to.not.have.property('contrasena');",
                  "    pm.collectionVariables.set('adminToken', json.data.token);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
